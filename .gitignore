# Závislosti (Netlify si je nainstaluje sám z package.json)
node_modules/

# Systémové smetí
.DS_Store
*.log

# Tajné proměnné (nikdy do gitu!)
.env
.env.*

# Netlify lokální
.netlify/

# Lokální schvalovací náhledy pro Codex / Claude — nejsou součást webu
/.claude/

# Dočasné soubory
scratchpad/
*.tmp

# Placený produkt — presety patří do soukromého Supabase Storage, ne na web.
# Netlify publikuje celý kořen repa, takže odsud by je stáhl kdokoli zdarma.
/presets/

# Graphify: keep the portable graph, report and visualization in Git; local
# provider cost/cache data are machine-specific and can invalidate prompt caches.
/graphify-out/cost.json
/graphify-out/cache/
/graphify-out/.graphify_python
/graphify-out/.graphify_root
